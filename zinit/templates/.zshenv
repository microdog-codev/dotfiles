# Machine-specific Zsh settings. Uncomment and customize as needed.

# Prefer executables installed in the standard user-local directory.
export PATH="$HOME/.local/bin:$PATH"

# Uncomment after installing Bun to expose its executables.
# export PATH="$HOME/.bun/bin:$PATH"

# Proxy defaults used by pctl.
# export PCTL_PROXY_ADDRESS="127.0.0.1"
# export PCTL_PROXY_PORT="6152"
# export PCTL_NO_PROXY="localhost,127.0.0.1,::1"

# Skip the system-wide compinit call when the host configuration supports it.
# skip_global_compinit=1
